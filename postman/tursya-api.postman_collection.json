                 {
                     "name":  "Change my credits (must fail)",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "   pm.test(\"refused with 403\", () =\u003e pm.response.to.have.status(403));\r\n   pm.test(\"protected column error\", () =\u003e pm.expect(pm.response.text()).to.include(\"PROTECTED_COLUMN\"));"
                                                               ]
                                                  }
                                   }
                               ],
                     "request":  {
                                     "method":  "PATCH",
                                     "header":  [
